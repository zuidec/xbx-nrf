/*
 * xbx-nrf dongle, Rev1 (pcb/xbx-nrf-dongle/), shared by both variants. Raytac
 * MDBT50Q-U1MV2 in normal voltage mode: VDD and VDDH from a 3.3 V LDO, so
 * REG0 is unused. The module
 * carries the REG1 DC/DC inductors. LEDs sink to their GPIO (active low),
 * so their PWM pins are open-drain: "off" floats the pin instead of driving
 * it high.
 */

#include <nordic/nrf52840_qiaa.dtsi>
#include "xbx_dongle_nrf52840-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>

/ {
	model = "xbx-nrf dongle";
	compatible = "xbx-nrf,dongle";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	/* 1 ms period; brightness from the configurator (leds.c) */
	pwmleds {
		compatible = "pwm-leds";

		/* blue, 180 Ω: high drive (low side) */
		pair_led: pair_led {
			pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "PAIR_LED (blue)";
		};

		p1_led: p1_led {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "P1_LED (green)";
		};

		p2_led: p2_led {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "P2_LED (green)";
		};

		p3_led: p3_led {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "P3_LED (green)";
		};

		p4_led: p4_led {
			pwms = <&pwm0 3 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "P4_LED (green)";
		};

		/* only with JP1 2–3 bridged (pinctrl: why open-drain matters here) */
		pwr_led: pwr_led {
			pwms = <&pwm1 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "PWR_LED (red)";
		};
	};

	buttons {
		compatible = "gpio-keys";

		pair_sw: pair_sw {
			gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "PAIR_SW";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		sw0 = &pair_sw;
		pwm-led0 = &pair_led;
		pwm-led1 = &p1_led;
		pwm-led2 = &p2_led;
		pwm-led3 = &p3_led;
		pwm-led4 = &p4_led;
		pwm-led5 = &pwr_led;
		watchdog0 = &wdt0;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&uicr {
	gpio-as-nreset;
};

&adc {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};
