menu "xbx-nrf controller"

config XBX_WIRED
	bool "Wired mode: be a USB gamepad while a PC has the device configured"
	default y if !XBX_FAKE_INPUT
	help
	  The radio pauses while wired; a charger alone doesn't count. Turn off
	  to test the wireless link with the USB console attached (off by
	  default with the fake input, which is for link tests).

config XBX_USB_CONSOLE
	bool "USB serial console as a composite function"
	default y
	help
	  Adds the CDC ACM serial port (log console) next to the wired-mode
	  gamepad on the controller's USB device. On for development builds.

config XBX_FAKE_INPUT
	bool "Send a test pattern instead of real input"
	help
	  Sticks circle slowly, triggers ramp, and random buttons are pressed
	  and released at random intervals (seeded from the chip ID, so two
	  controllers differ). Needs no input hardware (link tests).

config XBX_LSTICK_INVERT_X
	bool "Invert the left stick X axis"
	depends on !XBX_FAKE_INPUT
	help
	  Report convention: right = positive. Set if the stick reads the
	  wrong way round.

config XBX_LSTICK_INVERT_Y
	bool "Invert the left stick Y axis"
	depends on !XBX_FAKE_INPUT
	help
	  Report convention: up = positive. Set if the stick reads the wrong
	  way round.

endmenu

source "Kconfig.zephyr"
