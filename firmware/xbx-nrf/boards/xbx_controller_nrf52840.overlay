/*
 * xbx-nrf controller (custom board, boards/xbx/xbx_controller/). Buttons on
 * GPIOs here, the rest on the PCAL6416 (board node pcal6416); sticks and
 * triggers on the SAADC (docs/hardware.md, "Analog inputs"); rumble on pwm1.
 * The board's console is the J3 UART; the app moves it to a USB serial
 * function, as on the Pro Micro.
 */

#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <../boards/common/usb/cdc_acm_serial.dtsi>

/ {
	zephyr,user {
		/* no pull-ups on the board: Guide, Pair via diodes, B/LS/RS via 1 kΩ */
		guide-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		pair-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		b-gpios = <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		ls-gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		rs-gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/* 1V8_STICK (U4 EN, 100 kΩ pull-down): on while running */
		vcc-enable-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;

		/* TRG+ (Q1 gate, pull-up): on around each sample */
		trg-enable-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;

		/* channel n = AINn; AIN6 (VBAT) for battery monitoring later */
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>,
			      <&adc 5>, <&adc 7>;
		io-channel-names = "v18", "rt", "ly", "lx", "lt", "ry", "rx";

		/* scope timing pin (TP4) */
		timing-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;

		/*
		 * pairing indicator: the Guide LED; outside pairing solid while
		 * linked, slow blink while searching
		 */
		pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>,
		       <&pwm1 0 PWM_USEC(40) PWM_POLARITY_NORMAL>,
		       <&pwm1 1 PWM_USEC(40) PWM_POLARITY_NORMAL>,
		       <&pwm1 2 PWM_USEC(40) PWM_POLARITY_NORMAL>,
		       <&pwm1 3 PWM_USEC(40) PWM_POLARITY_NORMAL>;
		pwm-names = "indicator", "motor-heavy", "motor-weak", "motor-lt",
			    "motor-rt";
		indicator-idle;

		/* rumble: HIN above at 25 kHz (A3910 needs >= 20 kHz), LIN here */
		motor-lin-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>,
				  <&gpio0 8 GPIO_ACTIVE_HIGH>,
				  <&gpio0 21 GPIO_ACTIVE_HIGH>,
				  <&gpio0 7 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * Sticks: internal 0.6 V reference, gain 1/3 (0..1.8 V), read as a ratio to
 * v18 (gain 1/4, so 1.8 V doesn't clip; input.c's RAIL_GAIN_*). Triggers:
 * VDD/4 reference, gain 1/4 (0..VDD, ratiometric like the A1304).
 */
#define STICK_CH(n)                                                               \
	channel@n {                                                               \
		reg = <n>;                                                        \
		zephyr,gain = "ADC_GAIN_1_3";                                     \
		zephyr,reference = "ADC_REF_INTERNAL";                            \
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;                 \
		zephyr,input-positive = <NRF_SAADC_AIN##n>;                       \
		zephyr,resolution = <12>;                                         \
	}

#define TRIGGER_CH(n)                                                             \
	channel@n {                                                               \
		reg = <n>;                                                        \
		zephyr,gain = "ADC_GAIN_1_4";                                     \
		zephyr,reference = "ADC_REF_VDD_1_4";                             \
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;                 \
		zephyr,input-positive = <NRF_SAADC_AIN##n>;                       \
		zephyr,resolution = <12>;                                         \
	}

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	/* 1V8_STICK */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};

	TRIGGER_CH(1); /* RT */
	STICK_CH(2);   /* LS_Y */
	STICK_CH(3);   /* LS_X */
	TRIGGER_CH(4); /* LT */
	STICK_CH(5);   /* RS_Y */
	STICK_CH(7);   /* RS_X */
};

/* 1 kHz report timer (TIMER2 is used by ESB) */
&timer3 {
	status = "okay";
};
