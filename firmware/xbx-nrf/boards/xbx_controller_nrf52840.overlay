/*
 * xbx-nrf controller (custom board, boards/xbx/xbx_controller/). Buttons on
 * GPIOs here, the rest on the PCAL6416 (board node pcal6416); sticks,
 * triggers and rumble not yet. The board's console is the J3 UART; the app
 * moves it to a USB serial function, as on the Pro Micro.
 */

#include <../boards/common/usb/cdc_acm_serial.dtsi>

/ {
	zephyr,user {
		/* no pull-ups on the board: Guide, Pair via diodes, B/LS/RS via 1 kΩ */
		guide-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		pair-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		b-gpios = <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		ls-gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		rs-gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/* scope timing pin (TP4) */
		timing-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;

		/*
		 * pairing indicator: the Guide LED; outside pairing solid while
		 * linked, slow blink while searching
		 */
		pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		pwm-names = "indicator";
		indicator-idle;
	};
};

/* A3910 inputs held low (both drivers asleep) until rumble PWM exists */
&gpio0 {
	rmb_off0: rmb_off0 {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>, <7 GPIO_ACTIVE_HIGH>, <8 GPIO_ACTIVE_HIGH>,
			<17 GPIO_ACTIVE_HIGH>, <19 GPIO_ACTIVE_HIGH>, <20 GPIO_ACTIVE_HIGH>,
			<21 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "RMB";
	};
};

&gpio1 {
	rmb_off1: rmb_off1 {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "RMB";
	};
};

/* 1 kHz report timer (TIMER2 is used by ESB) */
&timer3 {
	status = "okay";
};
