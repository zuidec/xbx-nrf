/*
 * Board-independent USB functions, added to every build via
 * EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt (app.overlay would be ignored,
 * because board overlays exist).
 */

&zephyr_udc0 {
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "XBX-NRF Dongle";
		protocol-code = "none";
		in-report-size = <16>;
		in-polling-period-us = <1000>;
		/*
		 * Also the OUT endpoint's max packet size: keep it above the 6-byte
		 * report so each report is a short packet that ends its transfer.
		 */
		out-report-size = <64>;
		out-polling-period-us = <1000>; /* PID uploads send several reports in a row */
	};
};
