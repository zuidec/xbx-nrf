menu "xbx-nrf dongle"

config XBX_USB_CONSOLE
	bool "USB serial console as a composite function"
	default y
	help
	  Adds the CDC ACM serial port (log console) next to the gamepad on the
	  dongle's USB device. On for development builds; release.conf turns it
	  off.

config XBX_PAIR_RSSI_MIN
	int "Weakest pairing request accepted, -dBm"
	range 20 100
	default 50
	help
	  Pairing requests received weaker than -<this> dBm are ignored, so
	  only a controller held close to the dongle pairs. Raise it if
	  pairing at arm's length fails.

endmenu

source "Kconfig.zephyr"
